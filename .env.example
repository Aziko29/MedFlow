# .env.example
#
# Bu — NAMUNA fayl, haqiqiy qiymatlarsiz. Foydalanish uchun:
#   1. Shu faylni nusxalab, nomini ".env" ga o'zgartiring
#   2. Har bir qiymatni o'zingiznikiga to'ldiring
#   3. .env faylini HECH QACHON git'ga qo'shmang (.gitignore'da allaqachon
#      bor — tekshirib qo'ying)
#
# .env fayli mavjud bo'lsa, database.py uni avtomatik yuklaydi
# (python-dotenv orqali) — main.py yoki seed.py ishga tushishidan oldin
# environment o'zgaruvchilarini qo'lda export qilish shart emas.

# 🌍 Muhit: "production" bo'lsa — cookie faqat HTTPS orqali yuboriladi
# (secure=True), server 0.0.0.0'da tinglaydi, avtomatik reload o'chadi.
# Development uchun shunchaki o'chirib qo'ying yoki "development" yozing.
ENV=development

# 🔐 MAJBURIY — sessiya cookie'larini imzolash uchun maxfiy kalit.
# Generatsiya qilish: python -c "import secrets; print(secrets.token_hex(32))"
# Bu qiymatsiz dastur ISHGA TUSHMAYDI (ataylab shunday, 2.4-band).
CLINICFLOW_SECRET_KEY=

# 🔐 Maydon darajasidagi shifrlash (Patient.phone/address/medical_notes)
# Generatsiya: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# Bu qiymatsiz dastur birinchi bemor amalida FieldEncryptionError bilan qulaydi.
CLINICFLOW_FIELD_KEY=
# 🔍 Shifrlangan maydonlarda aniq moslik qidirish uchun (blind index), alohida kalit
CLINICFLOW_BLIND_INDEX_KEY=

# 🗄️ Ma'lumotlar bazasi manzili.
# Standart (o'rnatilmasa): mahalliy SQLite fayli — hech narsa o'rnatish
# shart emas, kichik klinikalar uchun yetarli.
#   DATABASE_URL=sqlite:///./clinicflow.db
#
# Bir nechta xodim bir vaqtda ishlaydigan katta klinika uchun PostgreSQL
# tavsiya etiladi (psycopg2-binary o'rnatilishi kerak: requirements.txt):
#   DATABASE_URL=postgresql+psycopg2://user:parol@localhost:5432/clinicflow
DATABASE_URL=sqlite:///./clinicflow.db

# 🌐 Server porti (ixtiyoriy, standart: 8000)
PORT=8000

# 🧠 Ko'p-worker (gunicorn --workers N > 1) rejimida MARKAZLASHGAN
# holat uchun Redis manzili — ixtiyoriy, lekin production'da (bir nechta
# worker bilan) TAVSIYA ETILADI (4-band). Sozlansa:
#   - auth.py'dagi foydalanuvchi keshi barcha workerlar bo'ylab umumiy
#     bo'ladi (parol/rol o'zgarishi darhol hammasiga ta'sir qiladi).
#   - rate_limiter.py'dagi /login brute-force cheklovi ham umumiy
#     hisoblanadi (worker soniga bo'linib zaiflashmaydi).
# Sozlanmasa — bitta workerli development uchun yetarli, lekin bir nechta
# worker bilan ishlatilsa README'ning "Production uchun" bo'limidagi
# xavf hisobga olinishi kerak.
#   CLINICFLOW_REDIS_URL=redis://localhost:6379/0
CLINICFLOW_REDIS_URL=

# 📲 Telegram eslatma tizimi (reminder_service.py) — ixtiyoriy.
# Bo'sh qoldirsangiz, servis avtomatik o'chirilgan holda ishlaydi.
# @BotFather'dan bot yarating va tokenni shu yerga qo'ying:
TELEGRAM_BOT_TOKEN=
# Bekor qilish linklari shu domenga quriladi (masalan https://clinic.example.com):
MEDFLOW_BASE_URL=http://localhost:8000
# Eslatma job qancha tez-tez tekshiradi, soniyada (standart 900 = 15 daqiqa):
REMINDER_POLL_SECONDS=900
# Xabarlarda ko'rsatiladigan klinika nomi:
CLINIC_NAME=ClinicFlow

# 📩 SMS integratsiyasi (Eskiz.uz, eskiz_client.py) — ixtiyoriy.
# ESKIZ_EMAIL/ESKIZ_PASSWORD bo'sh qoldirilsa, SMS yuborish jim
# o'chirilgan holatda ishlaydi (TELEGRAM_BOT_TOKEN kabi) — dastur
# ishlashda davom etadi, faqat SMS jo'natilmaydi.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# Jo'natuvchi nomi (ixtiyoriy, standart "4546"):
ESKIZ_SENDER_NICK=4546

# 🔐 MAJBURIY (2-qatlam himoya) — "Sozlamalar > Xavfli amallar" bo'limidagi
# amallarni (masalan bazani tozalash) tasdiqlash uchun ALOHIDA parol —
# xodimning login paroli EMAS (qarang: modules/settings_module.py
# perform_dangerous_action). Bo'sh qoldirilsa, xavfli amallar 500 xatolik
# bilan to'liq bloklanadi (jimgina o'tkazib yuborilmaydi).
CLINICFLOW_ADMIN_ACTIONS_PASSWORD=

# 🔐 Sessiya (login) muddati, daqiqada — ixtiyoriy (15.3-band).
# Bo'sh qoldirilsa standart 480 daqiqa (8 soat, bitta ish kuni) ishlatiladi
# (auth.py). Qiymat ham cookie umrini, ham signed-token muddat tekshiruvini
# belgilaydi — ikkalasi HAR DOIM bir xil (auth.SESSION_MAX_AGE_SECONDS,
# yagona manba).
SESSION_EXPIRE_MINUTES=480

# ℹ️ QUYIDAGILAR ATAYLAB BU YERDA YO'Q — hujjatlashtirish uchun eslatma:
#
# GOV_INTEGRATION_KEY — davlat identifikatsiya tizimi (OneID) API kaliti
#   BU LOYIHADA .env orqali emas, admin panel orqali sozlanadi va bazada
#   AES-256-GCM bilan SHIFRLANGAN holda saqlanadi (qarang:
#   modules/gov_integration.py, /api/admin/gov-integration/settings —
#   faqat admin). Sabab: klinikalar bu kalitni o'zi, ilovani qayta ishga
#   tushirmasdan (deploy/redeploy qilmasdan) kiritish/almashtirish imkonini
#   xohlaydi, va API kaliti kabi maxfiy qiymatlarni .env fayliga (odatda
#   versiyalash tizimidan chetlatilgan bo'lsa-da, serverlarda ko'p marta
#   qo'lda ko'chiriladigan oddiy matn fayl) yozishdan ko'ra shifrlangan DB
#   ustunida saqlash xavfsizroq. .env orqali sozlash kerak bo'lsa, buni
#   alohida so'rov sifatida bering — hozircha kod bunga mos emas.
#
# BACKUP_PATH — zaxira nusxa manzili
#   BU LOYIHADA .env orqali emas, backup_settings.json (yoki admin
#   panel > Backup sozlamalari) orqali sozlanadi — bir nechta manzil
#   (papka/tarmoq/tashqi xotira) va jadval (schedule_hour/minute) bir
#   vaqtda kerak bo'lgani uchun bitta ENV qatoriga sig'maydi (qarang:
#   backup_manager.py: DEFAULT_DESTINATIONS, load_settings()). Standart
#   holatda mahalliy nusxa loyiha papkasidagi backups/ ichiga yoziladi.
#   BACKUP_RETENTION_DAYS ham shu sababdan yo'q — saqlash muddati
#   backup_manager.py'dagi KEEP_DAYS konstantasi (30 kun).
#
# ONEID_API_URL / ONEID_API_KEY / ONEID_API_SECRET / ONEID_ORG_ID —
#   yuqoridagi GOV_INTEGRATION_KEY bilan bir xil sabab: bular admin panel
#   orqali (GovIntegrationSettings jadvali, shifrlangan) sozlanadi, .env
#   orqali emas.
#
# SESSION_MAX_AGE_SECONDS (soniyada) — YO'Q, chunki xuddi shu narsa endi
#   yuqoridagi SESSION_EXPIRE_MINUTES (daqiqada) orqali sozlanadi — ikkita
#   turli birlikdagi o'zgaruvchini bitta narsa uchun saqlash chalkashlik
#   keltirib chiqaradi.
#
# MAX_LOGIN_ATTEMPTS / LOCKOUT_DURATION_MINUTES — YO'Q, chunki bular
#   allaqachon .env EMAS, DB orqali (Sozlamalar > Tizim, SystemSettings
#   jadvali, modules/settings_module.py) boshqariladi. DIQQAT: hozircha
#   bu qiymatlar faqat saqlanadi/ko'rsatiladi — auth.py/rate_limiter.py'da
#   HALI real ishlatilmaydi (kodda ochiq izohlangan, keyingi bosqich
#   sifatida qoldirilgan). .env orqali sozlanadigan qildim desangiz, bu —
#   DB-asoslangan mexanizmni almashtiradigan alohida, ataylab qilinishi
#   kerak bo'lgan qaror, shuning uchun so'ramasdan qo'shmadim.
#
# ENABLE_SECURITY_MONITORING — YO'Q, chunki xavfsizlik markazi
#   (security_center.py: login loglari, tizim xatoliklari) hech qanday
#   yoqish/o'chirish bayrog'isiz, doim yoqilgan holda ishlaydi — o'chirish
#   imkoniyati kodda umuman yo'q.

