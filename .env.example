# .env.example
#
# Bu — NAMUNA fayl, haqiqiy qiymatlarsiz. Foydalanish uchun:
#   1. Shu faylni nusxalab, nomini ".env" ga o'zgartiring
#   2. Har bir qiymatni o'zingiznikiga to'ldiring
#   3. .env faylini HECH QACHON git'ga qo'shmang (.gitignore'da allaqachon
#      bor — tekshirib qo'ying)
#
# .env fayli mavjud bo'lsa, database.py uni avtomatik yuklaydi
# (python-dotenv orqali) — main.py yoki seed.py ishga tushishidan oldin
# environment o'zgaruvchilarini qo'lda export qilish shart emas.

# 🌍 Muhit: "production" bo'lsa — cookie faqat HTTPS orqali yuboriladi
# (secure=True), server 0.0.0.0'da tinglaydi, avtomatik reload o'chadi.
# Development uchun shunchaki o'chirib qo'ying yoki "development" yozing.
ENV=development

# 🔐 MAJBURIY — sessiya cookie'larini imzolash uchun maxfiy kalit.
# Generatsiya qilish: python -c "import secrets; print(secrets.token_hex(32))"
# Bu qiymatsiz dastur ISHGA TUSHMAYDI (ataylab shunday, 2.4-band).
CLINICFLOW_SECRET_KEY=

# 🔐 Maydon darajasidagi shifrlash (Patient.phone/address/medical_notes)
# Generatsiya: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# Bu qiymatsiz dastur birinchi bemor amalida FieldEncryptionError bilan qulaydi.
CLINICFLOW_FIELD_KEY=
# 🔍 Shifrlangan maydonlarda aniq moslik qidirish uchun (blind index), alohida kalit
CLINICFLOW_BLIND_INDEX_KEY=

# 🗄️ Ma'lumotlar bazasi manzili.
# Standart (o'rnatilmasa): mahalliy SQLite fayli — hech narsa o'rnatish
# shart emas, kichik klinikalar uchun yetarli.
#   DATABASE_URL=sqlite:///./clinicflow.db
#
# Bir nechta xodim bir vaqtda ishlaydigan katta klinika uchun PostgreSQL
# tavsiya etiladi (psycopg2-binary o'rnatilishi kerak: requirements.txt):
#   DATABASE_URL=postgresql+psycopg2://user:parol@localhost:5432/clinicflow
DATABASE_URL=sqlite:///./clinicflow.db

# 🌐 Server porti (ixtiyoriy, standart: 8000)
PORT=8000

# 🧠 Ko'p-worker (gunicorn --workers N > 1) rejimida MARKAZLASHGAN
# holat uchun Redis manzili — ixtiyoriy, lekin production'da (bir nechta
# worker bilan) TAVSIYA ETILADI (4-band). Sozlansa:
#   - auth.py'dagi foydalanuvchi keshi barcha workerlar bo'ylab umumiy
#     bo'ladi (parol/rol o'zgarishi darhol hammasiga ta'sir qiladi).
#   - rate_limiter.py'dagi /login brute-force cheklovi ham umumiy
#     hisoblanadi (worker soniga bo'linib zaiflashmaydi).
# Sozlanmasa — bitta workerli development uchun yetarli, lekin bir nechta
# worker bilan ishlatilsa README'ning "Production uchun" bo'limidagi
# xavf hisobga olinishi kerak.
#   CLINICFLOW_REDIS_URL=redis://localhost:6379/0
CLINICFLOW_REDIS_URL=

# 📲 Telegram eslatma tizimi (reminder_service.py) — ixtiyoriy.
# Bo'sh qoldirsangiz, servis avtomatik o'chirilgan holda ishlaydi.
# @BotFather'dan bot yarating va tokenni shu yerga qo'ying:
TELEGRAM_BOT_TOKEN=
# Bekor qilish linklari shu domenga quriladi (masalan https://clinic.example.com):
MEDFLOW_BASE_URL=http://localhost:8000
# Eslatma job qancha tez-tez tekshiradi, soniyada (standart 900 = 15 daqiqa):
REMINDER_POLL_SECONDS=900
# Xabarlarda ko'rsatiladigan klinika nomi:
CLINIC_NAME=ClinicFlow

# 📩 SMS integratsiyasi (Eskiz.uz, eskiz_client.py) — ixtiyoriy.
# ESKIZ_EMAIL/ESKIZ_PASSWORD bo'sh qoldirilsa, SMS yuborish jim
# o'chirilgan holatda ishlaydi (TELEGRAM_BOT_TOKEN kabi) — dastur
# ishlashda davom etadi, faqat SMS jo'natilmaydi.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# Jo'natuvchi nomi (ixtiyoriy, standart "4546"):
ESKIZ_SENDER_NICK=4546

