# deploy/nginx_clinicflow.conf.example
#
# Nginx reverse-proxy konfiguratsiyasi (5-band, 5.4) — gunicorn'ga
# proksi qiladi, TLS'ni (Let's Encrypt/certbot) va statik fayllarni
# to'g'ridan-to'g'ri Nginx orqali uzatadi (Python ilovasidan tezroq).
#
# O'RNATISH:
#   1. <domen_nomi>ni almashtiring
#   2. sudo cp deploy/nginx_clinicflow.conf.example /etc/nginx/sites-available/clinicflow
#   3. sudo ln -s /etc/nginx/sites-available/clinicflow /etc/nginx/sites-enabled/
#   4. sudo nginx -t   (konfiguratsiyani tekshirish)
#   5. sudo systemctl reload nginx
#   6. TLS uchun: sudo certbot --nginx -d <domen_nomi>
#      (certbot avtomatik ravishda pastdagi konfiguratsiyani HTTPS'ga
#      moslashtiradi va sertifikatni yangilab turadi)

server {
    listen 80;
    server_name <domen_nomi>;

    # Statik fayllarni to'g'ridan-to'g'ri Nginx uzatadi — Python ilovasi
    # bunga aralashmaydi, tezroq va CPU'ni tejaydi.
    location /static/ {
        alias <loyiha_papkasi_toliq_yoli>/static/;
        expires 7d;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
